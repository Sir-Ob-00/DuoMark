# For live authentication and reports (use a same-origin /api/v1 proxy in production):
VITE_API_BASE_URL=/api/v1
# Vite-only target; production should proxy /api to the API service.
API_PROXY_TARGET=http://localhost:5000
# Optional staff dashboard SSE hints; polling remains the fallback.
VITE_LIVE_EVENTS=true
# Local face-only service. Never put pairing/device tokens in VITE variables.
VITE_LOCAL_FACE_BRIDGE_URL=http://127.0.0.1:8765
