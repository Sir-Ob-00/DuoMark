# Documentation only: this stdlib service reads process environment variables.
# It does not automatically load this file or .env.
DUOMARK_MODE=disabled
# Enable offline-simulation OR express-development explicitly.
DUOMARK_API_URL=http://127.0.0.1:5000/api/v1
DUOMARK_TERMINAL_ID=YOUR_FICTIONAL_TERMINAL_ID
DUOMARK_DEVICE_TOKEN=YOUR_43_CHARACTER_DEVELOPMENT_DEVICE_CREDENTIAL
DUOMARK_TIMEOUT=10

# Local webcam commands are isolated from DUOMARK_MODE and Express credentials.
DUOMARK_CAMERA_INDEX=0
# Windows default dshow; alternatives msmf or auto.
DUOMARK_CAMERA_BACKEND=dshow
# Defaults resolve under biometric-terminal/, independent of working directory.
# DUOMARK_FACE_MODEL_DIR=D:\Projects\multimodal-biometric-attendance\biometric-terminal\models
# DUOMARK_FACE_STORE_DIR=D:\Projects\multimodal-biometric-attendance\biometric-terminal\data\faces
DUOMARK_FACE_THRESHOLD=0.363
DUOMARK_FACE_SAMPLES=5
DUOMARK_FACE_TIMEOUT=60
DUOMARK_FACE_MIN_SIZE=80
DUOMARK_FACE_MIN_BLUR=50

# Paired loopback bridge (python -m biometric_terminal serve)
# DUOMARK_TERMINAL_ID must match the frontend /terminal/:terminalId.
DUOMARK_BRIDGE_TOKEN=YOUR_SEPARATE_43_CHARACTER_LOCAL_PAIRING_TOKEN
DUOMARK_BRIDGE_ORIGIN=http://localhost:5173
DUOMARK_BRIDGE_PORT=8765
