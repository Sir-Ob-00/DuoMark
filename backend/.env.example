DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/duomark_dev
PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=28800
SESSION_SAME_SITE=lax
# Set true for HTTPS. Production always uses Secure cookies.
SESSION_SECURE=false
# Real capture is unavailable. Fake requires NODE_ENV=development AND explicit opt-in.
BIOMETRIC_CAPTURE_MODE=disabled
# Device check-ins require separate production adapters (not implemented).
# Fake requires development/test mode, this explicit opt-in and fictional fixtures.
CHECK_IN_MODE=disabled
# Optional process-local staff/device SSE notifications (false disables /events).
EVENTS_ENABLED=true
# Set only when deployed behind known proxies, for example: loopback
# TRUST_PROXY=
# Provide DEV_ADMIN_EMAIL / DEV_ADMIN_PASSWORD temporarily in PowerShell,
# using the hidden password prompt documented in README.md.
# Lecturer invitations remain disabled: no trusted provisioning/redemption or
# approved delivery/test transport is implemented. Environment flags cannot enable them.
